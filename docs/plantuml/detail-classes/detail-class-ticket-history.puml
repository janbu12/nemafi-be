@startuml
title Detail Class TicketHistory

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
hide circle

class TicketHistory {
  - id: Int
  - ticketId: Int
  - action: String
  - description: String
  - actorType: TicketHistoryActor
  - actorId: Int
  - createdAt: DateTime
  --
  + addHistory()
  + addHistoryEntry()
  + getHistory()
}

class "«enumeration»\nTicketHistoryActor" as TicketHistoryActor {
  SYSTEM
  ADMIN
  TECHNICIAN
  CUSTOMER
}

TicketHistory ..> TicketHistoryActor
TicketHistory --> Ticket
TicketHistory --> User
@enduml
