@startuml
title Detail Class Ticket

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
hide circle

class Ticket {
  - id: Int
  - orderId: Int
  - technicianId: Int
  - status: TicketStatus
  - paymentStatus: TicketPaymentStatus
  - expiresAt: DateTime
  - expiredAt: DateTime
  - paidAt: DateTime
  - title: String
  - description: String
  - categoryId: Int
  - scheduledAt: DateTime
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + createTicket()
  + assignTicket()
  + scheduleTicket()
  + updateStatus()
  + getAllTickets()
  + getMyTickets()
  + createSupportTicket()
  + getMySupportTickets()
  + markTicketPaid()
}

class "«enumeration»\nTicketStatus" as TicketStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

class "«enumeration»\nTicketPaymentStatus" as TicketPaymentStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
}

Ticket ..> TicketStatus
Ticket ..> TicketPaymentStatus
Ticket --> Order
Ticket --> User
Ticket --> TicketCategory
@enduml
