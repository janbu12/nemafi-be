@startuml
title Detail Class BillingSetting

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
hide circle

class BillingSetting {
  - id: Int
  - automationEnabled: Boolean
  - suspendCron: String
  - renewCron: String
  - graceDays: Int
  - dueDays: Int
  - periodDays: Int
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + getBillingSettings()
  + updateBillingSettings()
  + applyOverdueSuspension()
  + generateMonthlyInvoices()
}
@enduml
