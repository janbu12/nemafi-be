@startuml
title Detail Class BillingInvoice

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
hide circle

class BillingInvoice {
  - id: Int
  - userId: Int
  - amount: Float
  - periodStart: DateTime
  - periodEnd: DateTime
  - status: BillingStatus
  - dueAt: DateTime
  - paidAt: DateTime
  - createdAt: DateTime
  - updatedAt: DateTime
  --
  + listInvoices()
  + getInvoiceById()
  + payLatest()
  + markLatestInvoicePaid()
  + applyOverdueSuspension()
  + generateMonthlyInvoices()
}

class "«enumeration»\nBillingStatus" as BillingStatus {
  PAID
  UNPAID
  OVERDUE
}

BillingInvoice ..> BillingStatus
BillingInvoice --> User
@enduml
