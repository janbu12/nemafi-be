@startuml
title Detail Class TicketSurveyItem

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
hide circle

class TicketSurveyItem {
  - inventoryItemId: Int
  - name: String
  - quantity: Int
  - unit: String
  - notes: String
  - type: SurveyItemType
  --
  + completeSurvey()
  + reportSurveyActual()
  + updateSurvey()
}

class "«enumeration»\nSurveyItemType" as SurveyItemType {
  PLANNED
  ACTUAL
}

note right of TicketSurveyItem
Pada kode saat ini item survey
belum menjadi tabel terpisah.
Data disimpan pada TicketSurvey
plannedItems dan actualItems.
end note

TicketSurveyItem ..> SurveyItemType
TicketSurveyItem --> TicketSurvey
TicketSurveyItem --> InventoryItem
@enduml
