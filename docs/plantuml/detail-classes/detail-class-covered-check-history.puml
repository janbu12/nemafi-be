@startuml
title Detail Class CoverageCheckHistory

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
hide circle

class CoverageCheckHistory {
  - id: Int
  - fullAddress: String
  - province: String
  - city: String
  - district: String
  - village: String
  - userLocation: Geography
  - isCovered: Boolean
  - checkedAt: DateTime
  --
  + checkAvailability()
  + getCheckHistory()
}
@enduml
