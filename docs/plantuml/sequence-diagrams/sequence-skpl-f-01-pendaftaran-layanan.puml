@startuml
title SKPL-F-01 Sequence Diagram Pendaftaran Layanan

skinparam shadowing false
skinparam responseMessageBelowArrow true
hide footbox

actor Pelanggan
participant ":User" as User
participant ":Profile" as Profile
participant ":CoveredArea" as CoveredArea
participant ":CoverageCheckHistory" as CoverageCheckHistory
participant ":Package" as Package
participant ":Order" as Order
actor Admin

Pelanggan -> User: registerUser(dataAkun)
activate User
User --> Pelanggan: akunPelanggan
deactivate User

Pelanggan -> Profile: updateProfile(dataProfil, alamat, lokasi)
activate Profile
Profile --> Pelanggan: profileTersimpan
deactivate Profile

Pelanggan -> CoveredArea: checkAvailability(alamat, latitude, longitude)
activate CoveredArea
CoveredArea -> CoverageCheckHistory: checkAvailability()
activate CoverageCheckHistory
CoverageCheckHistory --> CoveredArea: riwayatTersimpan
deactivate CoverageCheckHistory
CoveredArea --> Pelanggan: hasilCakupanArea
deactivate CoveredArea

alt area tersedia
  Pelanggan -> Package: getAllPackages()
  activate Package
  Package --> Pelanggan: daftarPaket
  deactivate Package

  Pelanggan -> Package: getPackageById(packageId)
  activate Package
  Package --> Pelanggan: detailPaket
  deactivate Package

  Pelanggan -> Order: createOrder(userId, packageId)
  activate Order
  Order -> Package: getPackageById(packageId)
  activate Package
  Package --> Order: hargaPaket
  deactivate Package
  Order --> Pelanggan: orderStatusPENDING_REVIEW
  deactivate Order

  Order -> Admin: notifikasi order pending
else area tidak tersedia
  CoveredArea --> Pelanggan: pendaftaranTidakDilanjutkan
end

@enduml
