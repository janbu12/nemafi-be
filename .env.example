DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=3000
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=https://test.com,http://localhost:3000

# Midtrans Configuration (Sandbox for development)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIKROTIK_SIMULATION=true
ENABLE_BILLING_AUTOMATION=true
BILLING_SUSPEND_CRON=0 * * * *
BILLING_RENEW_CRON=10 0 1 * *
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=nemafi
R2_PUBLIC_BASE_URL=https://<your-public-domain>

VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:admin@domain-anda.com
